# Copia este archivo como .env y llena los valores

# API Key de GROQ para generación de narrativas con IA
# Obtener en: https://console.groq.com
GROQ_API_KEY=

# Clave de encriptación Fernet para credenciales Odoo
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=tu_clave_fernet_aqui

# Configuración para lectura de facturas XML (IMAP)
IMAP_SERVER=imap.tu-correo.com
IMAP_PORT=993
IMAP_USER=tu-email@dominio.com
IMAP_PASSWORD=tu-contrasena-de-aplicacion

# Neon PostgreSQL
NEON_DB_URL=postgresql://usuario:password@host:puerto/nombre-bd?sslmode=require

# ── FactuMatch Ventas (DIAN emitidos vs Odoo) ──
# Agente investigador con Claude (opcional). Sin clave, la conciliación y el
# reporte funcionan igual y el análisis IA aparece como «no disponible».
# La clave va SOLO aquí o en las variables de entorno de Render; nunca en el
# frontend ni en el repositorio. Obtenerla en https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Reglas de conciliación (valores por defecto acordados con el negocio)
VENTAS_TOLERANCIA_DOCUMENTO=1.00
VENTAS_MARGEN_DIAS=5

# Memoria: conciliaciones guardadas para reporte y agente (se pierden al reiniciar)
VENTAS_TTL_RESULTADOS=3600
VENTAS_MAX_RESULTADOS=5

# Límites del agente (coste y tiempo)
VENTAS_IA_MAX_HERRAMIENTAS=12
VENTAS_IA_TIMEOUT_TOTAL=120
VENTAS_IA_TIMEOUT_LLAMADA=60
VENTAS_IA_MAX_TOKENS=16000
